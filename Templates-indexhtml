<style>*{box-sizing:border-box}body{margin:0;font-family:system-ui;background:#0B3D1A;color:#222}.top{background:#0B3D1A;color:#FDE047;padding:14px;text-align:center;position:sticky;top:0;z-index:10}.wrap{max-width:1150px;margin:auto;background:#fff;padding:14px;min-height:100vh}input,select,textarea{padding:12px;width:100%;border:2px solid #ddd;border-radius:10px;margin:5px 0;font-size:15px}button{cursor:pointer}.btn{background:#25D366;border:none;padding:13px;border-radius:999px;font-weight:900;width:100%;margin-top:6px}.btn.dark{background:#0B3D1A;color:#FDE047}.btn.blue{background:#1565C0;color:#fff}.btn.red{background:#C62828;color:#fff}.btn.grey{background:#eee}.btn.purple{background:#7B1FA2;color:#fff}.btn.orange{background:#EF6C00;color:#fff}.tabs{display:flex;gap:8px;overflow:auto;padding:8px 0}.tabs button{padding:11px 14px;border:none;border-radius:999px;background:#eee;font-weight:800;white-space:nowrap}.tabs button.on{background:#0B3D1A;color:#FDE047}.cards{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px;margin:12px 0}.card{background:#0B3D1A;color:#fff;padding:14px;border-radius:14px;text-align:center}.card.green{background:#1B7A3D}.card.red{background:#C62828}.card.blue{background:#1565C0}.card.yellow{background:#F9A825;color:#222}table{width:100%;border-collapse:collapse;font-size:13px;margin-top:8px}th,td{border:1px solid #ddd;padding:8px;text-align:left}th{background:#0B3D1A;color:#fff}.small{font-size:12px;color:#666}.row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.box{border:2px dashed #0B3D1A;border-radius:12px;padding:12px;margin:10px 0;background:#F8FFF8}.bar{height:22px;background:#eee;border-radius:999px;overflow:hidden}.barFill{height:100%;background:#25D366;text-align:right;color:#fff;font-size:12px;font-weight:800;padding-right:6px}.chat{height:300px;overflow:auto;border:2px solid #ddd;border-radius:12px;padding:10px;background:#fff}.msg{padding:10px;border-radius:12px;margin:6px 0;max-width:85%;white-space:pre-line;font-size:13px;line-height:1.5}.msg.ai{background:#E8F5E9}.msg.user{background:#E3F2FD;margin-left:auto;text-align:right}.msg.cs{background:#F3E5F5}@media(max-width:600px){.cards{grid-template-columns:1fr 1fr}.row{grid-template-columns:1fr}}</style></head><body>
