<script>
const API=''; let DB={siswa:[],masuk:[],keluar:[],setting:{}}; let LAST_CS_ANSWER='',LAST_CS_SISWA=null;
const JENIS_KELUAR=["Belanja Sayur","Indihome","Transportasi","Partisipasi","ATK","Konsumsi","Sarpras","YYC","Bangunan","Gas","Beras","BPJS","Gajian Guru","Gajian Silat","Token Listrik","Qiroat","Gajian Tukang","Listrik"];
const JENIS_MASUK=["SPP","Infak Pesantren","DKS","IPP"];
let TARGET={SMP:{SPP:2110000,"Infak Pesantren":13075000,DKS:5510000,IPP:22250000},SMA:{SPP:2190000,"Infak Pesantren":3480000,DKS:2800000,IPP:8820000},SMK:{SPP:6480000,"Infak Pesantren":3450000,DKS:5200000,IPP:24650000}};
let ANGGARAN={"Belanja Sayur":3000000,"Indihome":500000,"Transportasi":2000000,"Partisipasi":1000000,"ATK":750000,"Konsumsi":2500000,"Sarpras":3000000,"YYC":1000000,"Bangunan":5000000,"Gas":800000,"Beras":2500000,"BPJS":1500000,"Gajian Guru":15000000,"Gajian Silat":2000000,"Token Listrik":1200000,"Qiroat":1500000,"Gajian Tukang":3000000,"Listrik":1200000};
function hariIni(){return new Date().toISOString().slice(0,10)}function tanggalIndo(d){return new Date(d||Date.now()).toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'})}function rupiah(n){return 'Rp '+Number(n||0).toLocaleString('id-ID')}function nisFix(v){var s=String(v||'').trim();if(/^\d+$/.test(s))return s.padStart(3,'0');return s.toUpperCase()}function persen(a,b){return b?Math.min(200,Math.round(a/b*100)):0}
function getPeriode(t){if(!t)return '-';var d=new Date(t);var nb=d.toLocaleDateString('id-ID',{month:'long'});return d.getDate()<=15?nb+' '+d.getFullYear()+' | Periode 1 (1-15)':nb+' '+d.getFullYear()+' | Periode 2 (16-'+new Date(d.getFullYear(),d.getMonth()+1,0).getDate()+')'}
function getKey(t){if(!t)return '0000';var d=new Date(t);return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+(d.getDate()<=15?'P1':'P2')}
function show(id,btn){document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('on'));if(btn)btn.classList.add('on');['dash','aiCS','aiAdmin','persen','masuk','keluar','siswa','rekap'].forEach(x=>{var e=document.getElementById(x);if(e)e.style.display=x===id?'block':'none'})}
async function loadData(){try{document.getElementById('saveStatus').textContent='🔄 Sync ke server...';const res=await fetch(API+'/api/data');const json=await res.json();if(!json.success)throw new Error(json.message||'Gagal load');DB.siswa=json.siswa||[];DB.masuk=json.masuk||[];DB.keluar=json.keluar||[];if(json.setting){TARGET.SMP.SPP=Number(json.setting.target_smp_spp||TARGET.SMP.SPP);TARGET.SMP['Infak Pesantren']=Number(json.setting.target_smp_infak||TARGET.SMP['Infak Pesantren']);TARGET.SMP.DKS=Number(json.setting.target_smp_dks||TARGET.SMP.DKS);TARGET.SMP.IPP=Number(json.setting.target_smp_ipp||TARGET.SMP.IPP)}document.getElementById('saveStatus').textContent='🟢 Terhubung — Database: database.db';renderAll()}catch(e){document.getElementById('saveStatus').textContent='🔴 Gagal: '+e.message+' — Pastikan server jalan!';console.error(e)}}
async function tambahSiswa(e){if(e)e.preventDefault();const p={nis:nisFix(document.getElementById('nis').value),nama:document.getElementById('namaSiswa').value.trim(),jenjang:document.getElementById('jenjang').value,kelas:document.getElementById('kelas').value,ortu:document.getElementById('namaOrtu').value,wa:document.getElementById('waOrtu').value};if(!p.nis||!p.nama)return alert('NIS & Nama wajib!');try{const r=await fetch(API+'/api/siswa',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});const j=await r.json();if(!j.success)throw new Error(j.message);['nis','namaSiswa','namaOrtu','waOrtu'].forEach(id=>document.getElementById(id).value='');await loadData();alert('✅ Siswa tersimpan ke SERVER!')}catch(err){alert('❌ Gagal: '+err.message)}return false}
async function simpanMasuk(e){if(e)e.preventDefault();const sid=document.getElementById('siswaMasuk').value;const s=DB.siswa.find(x=>String(x.id)===String(sid));const p={siswa_id:s?Number(s.id):null,siswa_nama:s?s.nama+' ('+s.nis+')':'Umum',jenjang:s?s.jenjang:document.getElementById('jenjangMasuk').value,jenis:document.getElementById('jenisMasuk').value,bulan:document.getElementById('bulanMasuk').value,jumlah:Number(document.getElementById('jmlMasuk').value),metode:document.getElementById('metodeMasuk').value,tgl:document.getElementById('tglMasuk').value||hariIni()};if(!p.jumlah||p.jumlah<=0)return alert('Jumlah harus > 0!');try{const r=await fetch(API+'/api/pemasukan',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});const j=await r.json();if(!j.success)throw new Error(j.message);document.getElementById('jmlMasuk').value='';await loadData();alert('✅ Pemasukan tersimpan!')}catch(err){alert('❌ Gagal: '+err.message)}return false}
async function simpanKeluar(e){if(e)e.preventDefault();const p={jenjang:document.getElementById('jenjangKeluar').value,jenis:document.getElementById('jenisKeluar').value,jumlah:Number(document.getElementById('jmlKeluar').value),penerima:document.getElementById('penerima').value,ket:document.getElementById('ketKeluar').value,tgl:document.getElementById('tglKeluar').value||hariIni()};if(!p.jumlah||p.jumlah<=0)return alert('Jumlah harus > 0!');try{const r=await fetch(API+'/api/pengeluaran',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});const j=await r.json();if(!j.success)throw new Error(j.message);document.getElementById('jmlKeluar').value='';await loadData();alert('✅ Pengeluaran tersimpan!')}catch(err){alert('❌ Gagal: '+err.message)}return false}
async function hapusSiswa(id){if(!confirm('Hapus siswa ini?'))return;try{await fetch(API+'/api/siswa/'+id,{method:'DELETE'});await loadData()}catch(e){alert('Gagal hapus: '+e.message)}}
async function hapusMasuk(id){if(!confirm('Hapus pemasukan ini?'))return;try{await fetch(API+'/api/pemasukan/'+id,{method:'DELETE'});await loadData()}catch(e){alert('Gagal hapus: '+e.message)}}
async function hapusKeluar(id){if(!confirm('Hapus pengeluaran ini?'))return;try{await fetch(API+'/api/pengeluaran/'+id,{method:'DELETE'});await loadData()}catch(e){alert('Gagal hapus: '+e.message)}}
function cariSiswa(teks){var t=String(teks||'').toLowerCase();var m=t.match(/\b(\d{2,4})\b/);if(m){var s=DB.siswa.find(x=>String(x.nis)===nisFix(m[1]));if(s)return s}var f=null;DB.siswa.forEach(s=>{if(t.indexOf(s.nama.toLowerCase().split(' ')[0])!==-1&&!f)f=s});return f}
function jawabanCS(teks){var t=String(teks||'').toLowerCase();if(t.indexOf('spp')!==-1){var j='SMP';if(t.indexOf('sma')!==-1)j='SMA';if(t.indexOf('smk')!==-1)j='SMK';return 'Untuk '+j+' — SPP: '+rupiah(TARGET[j].SPP)+' | Infak: '+rupiah(TARGET[j]['Infak Pesantren'])+' | DKS: '+rupiah(TARGET[j].DKS)+' | IPP: '+rupiah(TARGET[j].IPP)+'\nBayar ke: BRI 479701037976536 a.n SITI MASELAH'}if(t.indexOf('rekening')!==-1||t.indexOf('transfer')!==-1)return 'BANK BRI\nA.N SITI MASELAH\nNO REK: 479701037976536';var s=cariSiswa(teks);if(!s)return 'Maaf, tidak ketemu. Ketik NIS, contoh: 001 atau nama anak.';LAST_CS_SISWA=s;var bayar=DB.masuk.filter(m=>String(m.siswa_id)===String(s.id)||String(m.siswa_nama||'').indexOf(s.nis)!==-1);var tot=bayar.reduce((a,b)=>a+Number(b.jumlah||0),0);var out='Assalamualaikum Ayah Bunda '+s.nama+' 🙏\nNama: '+s.nama+'\nNIS: '+s.nis+'\nLembaga: '+s.jenjang+' — '+s.kelas+'\n\n💰 Total Sudah Dibayar: '+rupiah(tot)+'\n\n🎯 Rincian:\n';JENIS_MASUK.forEach(jenis=>{var tg=TARGET[s.jenjang][jenis]||0;var b=bayar.filter(x=>x.jenis===jenis).reduce((a,bb)=>a+Number(bb.jumlah||0),0);out+='• '+jenis+': '+rupiah(b)+' / '+rupiah(tg)+' — Sisa '+rupiah(Math.max(0,tg-b))+' ('+persen(b,tg)+'% '+(persen(b,tg)>=100?'✅ LUNAS':'')+')\n'});out+='\nBayar ke: BRI 479701037976536 a.n SITI MASELAH';return out}
function tambahChat(id,teks,isUser){var c=document.getElementById(id);var d=document.createElement('div');d.className='msg '+(isUser?'user':'ai');d.textContent=teks;c.appendChild(d);c.scrollTop=c.scrollHeight}
function kirimCS(){var inp=document.getElementById('inputCS');var t=inp.value.trim();if(!t)return;tambahChat('chatCS',t,true);inp.value='';setTimeout(()=>{var j=jawabanCS(t);LAST_CS_ANSWER=j;tambahChat('chatCS','👩‍💼 '+j,false)},300)}
function kirimCSkeWA(){if(!LAST_CS_SISWA)return alert('Cek tagihan dulu.');var no=String(LAST_CS_SISWA.wa||'').replace(/\D/g,'');if(no.charAt(0)==='0')no='62'+no.slice(1);if(!no)return alert('No WA kosong');window.open('https://wa.me/'+no+'?text='+encodeURIComponent(LAST_CS_ANSWER),'_blank')}
function parseJumlah(teks){var m=String(teks).toLowerCase().match(/(\d+)\s*(ribu|rb|k|jt|juta)?/);if(!m)return 0;var n=Number(m[1]);if(m[2]==='ribu'||m[2]==='rb'||m[2]==='k')n*=1000;if(m[2]==='jt'||m[2]==='juta')n*=1000000;return n}function parseJenisMasuk(teks){var t=teks.toLowerCase();if(t.indexOf('infak')!==-1)return 'Infak Pesantren';if(t.indexOf('dks')!==-1)return 'DKS';if(t.indexOf('ipp')!==-1)return 'IPP';return 'SPP'}
async function kirimAdmin(){var inp=document.getElementById('inputAdmin');var teks=inp.value.trim();if(!teks)return;tambahChat('chatAdmin',teks,true);inp.value='';await prosesAdmin(teks)}
function cepatAdmin(teks){document.getElementById('inputAdmin').value=teks;kirimAdmin()}
async function prosesAdmin(teks){var t=teks.toLowerCase();if(t.indexOf('rekap')!==-1){var per=getKey(hariIni());var m=DB.masuk.filter(x=>getKey(x.tgl)===per);var k=DB.keluar.filter(x=>getKey(x.tgl)===per);var tm=m.reduce((a,b)=>a+Number(b.jumlah||0),0);var tk=k.reduce((a,b)=>a+Number(b.jumlah||0),0);tambahChat('chatAdmin','🤖 Rekap 2 Mingguan — '+getPeriode(hariIni())+'\nMasuk: '+rupiah(tm)+' | Keluar: '+rupiah(tk)+' | Saldo: '+rupiah(tm-tk),false);return}if(t.indexOf('belum bayar')!==-1){var jenis=parseJenisMasuk(teks);var list=[];DB.siswa.forEach(s=>{var b=DB.masuk.filter(m=>String(m.siswa_id)===String(s.id)&&m.jenis===jenis).reduce((a,bb)=>a+Number(bb.jumlah||0),0);if(b<(TARGET[s.jenjang][jenis]||0))list.push(s.nama+' ('+s.jenjang+') — Sisa '+rupiah((TARGET[s.jenjang][jenis]||0)-b))});tambahChat('chatAdmin','🤖 Belum bayar '+jenis+' — '+list.length+' siswa:\n'+list.slice(0,15).join('\n'),false);return}if(t.indexOf('keluar')!==-1){var jml=pars
