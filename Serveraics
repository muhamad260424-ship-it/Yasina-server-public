def get_brosur():
    conn = sqlite3.connect(DB_FILE); conn.row_factory = sqlite3.Row
    r = conn.execute("SELECT * FROM brosur WHERE aktif=1 ORDER BY id DESC LIMIT 1").fetchone()
    conn.close(); return dict(r) if r else BROSUR_ASLI

def buat_notif(tipe, judul, isi):
    conn = sqlite3.connect(DB_FILE)
    conn.execute("INSERT INTO notif (tipe, judul, isi, waktu) VALUES (?,?,?,?)", (tipe, judul, isi, datetime.now().strftime('%Y-%m-%d %H:%M:%S')))
    conn.commit(); conn.close()

def simpan(data):
    conn = sqlite3.connect(DB_FILE); cur = conn.cursor()
    cur.execute("SELECT COUNT(*) FROM pendaftar"); no = cur.fetchone()[0] + 1
    tahun = str(data.get('tahun_pelajaran','2027/2028')).split('/')[0]
    data['no_pendaftaran'] = f"YASINA-{tahun}-{no:04d}"
    data['waktu'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    data['status'] = 'BARU'
    cols = [f for f in FIELDS if f in data]
    cur.execute(f"INSERT INTO pendaftar ({','.join(cols)}) VALUES ({','.join(['?']*len(cols))})", [str(data.get(f,''))[:9000] for f in cols])
    conn.commit(); conn.close()
    buat_notif("PENDAFTAR_BARU", f"🔔 Pendaftar Baru: {data.get('nama_lengkap')}",
               f"{data.get('nama_lengkap')} - {data.get('sekolah')} - WA {data.get('wa')} - No {data['no_pendaftaran']} - {data['waktu']}")
    return data

def ambil(after_id=0):
    conn = sqlite3.connect(DB_FILE); conn.row_factory = sqlite3.Row
    rows = [dict(r) for r in conn.execute("SELECT * FROM pendaftar WHERE id > ? ORDER BY id DESC", (after_id,))]
    conn.close(); return rows

def stat():
    conn = sqlite3.connect(DB_FILE)
    total = conn.execute("SELECT COUNT(*) FROM pendaftar").fetchone()[0]
    baru = conn.execute("SELECT COUNT(*) FROM pendaftar WHERE status='BARU'").fetchone()[0]
    notif_baru = conn.execute("SELECT COUNT(*) FROM notif WHERE sudah_dibaca=0").fetchone()[0]
    chat_baru = conn.execute("SELECT COUNT(*) FROM chat_log WHERE sudah_dibaca=0 AND siapa='CALON SANTRI'").fetchone()[0]
    conn.close(); return {"total":total,"baru":baru,"notif_baru":notif_baru,"chat_baru":chat_baru}

