    return j

def baca_html(nama):
    try: return open(nama, encoding='utf-8').read()
    except: return f"<h1>File {nama} belum diupload.</h1>"

class Handler(http.server.BaseHTTPRequestHandler):
    def end_headers(self):
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type')
        super().end_headers()
    def do_OPTIONS(self): self.send_response(200); self.end_headers()
    def do_GET(self):
        if self.path in ('/','/index.html'): self.kirim_html(baca_html('index.html'))
        elif self.path in ('/admin','/admin.html'): self.kirim_html(baca_html('admin.html'))
        elif self.path == '/api/data': self.kirim_json(ambil(0))
        elif self.path == '/api/brosur': self.kirim_json(get_brosur())
        elif self.path == '/api/info': self.kirim_json(INFO_YASINA)
        elif self.path.startswith('/api/baru'):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            after = int(q.get('after_id',[0])[0])
            self.kirim_json({"data": ambil(after), "stat": stat()})
        elif self.path == '/api/ping': self.kirim_json({"status":"ok","total":stat()["total"]})
        elif self.path == '/api/notif':
            conn = sqlite3.connect(DB_FILE); conn.row_factory = sqlite3.Row
            rows = [dict(r) for r in conn.execute("SELECT * FROM notif ORDER BY id DESC LIMIT 20")]; conn.close()
            self.kirim_json({"notif": rows, "stat": stat()})
        elif self.path == '/api/chat-log':
            conn = sqlite3.connect(DB_FILE); conn.row_factory = sqlite3.Row
            rows = [dict(r) for r in conn.execute("SELECT * FROM chat_log ORDER BY id DESC LIMIT 50")]; conn.close()
            self.kirim_json(rows)
        else: self.send_response(404); self.end_headers()
    def do_POST(self):
        panjang = int(self.headers.get('Content-Length',0))
        body = self.rfile.read(panjang).decode('utf-8') if panjang else '{}'
        if self.path == '/api/daftar':
            data = json.loads(body); lengkap = simpan(data)
            self.kirim_json({"status":"ok","no_pendaftaran":lengkap['no_pendaftaran']})
        elif self.path == '/api/ai-cs':
            d = json.loads(body); self.kirim_json({"jawaban": ai_cs_jawab(d.get('pertanyaan',''), stat()["total"])})
        elif self.path == '/api/ai-admin':
            d = json.loads(body); self.kirim_json({"jawaban": ai_admin_jawab(d.get('pertanyaan',''))})
        elif self.path == '/api/brosur':
            d = json.loads(body)
            conn = sqlite3.connect(DB_FILE)
            conn.execute("UPDATE brosur SET aktif=0")
            conn.execute("INSERT INTO brosur (judul, isi, biaya, syarat, jadwal, kontak, waktu, aktif) VALUES (?,?,?,?,?,?,?,1)",
                (d.get('judul','Brosur Baru'), d.get('isi',''), d.get('biaya',''), d.get('syarat',''), d.get('jadwal',''), d.get('kontak',''), datetime.now().strftime('%Y-%m-%d %H:%M:%S')))
            conn.commit(); conn.close()
            buat_notif("BROSUR", "📄 Brosur Baru Disimpan", f"Judul: {d.get('judul')} - AI CS sekarang pakai brosur baru ini.")
            self.kirim_json({"status":"ok"})
        elif self.path == '/api/baca-notif':
            conn = sqlite3.connect(DB_FILE); conn.execute("UPDATE notif SET sudah_dibaca=1"); conn.execute("UPDATE pendaftar SET status='DIBACA'"); conn.execute("UPDATE chat_log SET sudah_dibaca=1"); conn.commit(); conn.close()
            self.kirim_json({"status":"ok"})
        elif self.path == '/api/baca':
            conn = sqlite3.connect(DB_FILE); conn.execute("UPDATE pendaftar SET status='DIBACA'"); conn.commit(); conn.close()
            self.kirim_json({"status":"ok"})
        else: self.send_response(404); self.end_headers()
    def kirim_html(self, html):
        b = html.encode('utf-8'); self.send_response(200); self.send_header('Content-Type','text/html; charset=utf-8'); self.send_header('Content-Length',str(len(b))); self.end_headers(); self.wfile.write(b)
    def kirim_json(self, obj):
        b = json.dumps(obj, ensure_ascii=False).encode('utf-8'); self.send_response(200); self.send_header('Content-Type','application/json'); self.send_header('Content-Length',str(len(b))); self.end_headers(); self.wfile.write(b)
    def log_message(self, format, *args): print(f"[{datetime.now().strftime('%H:%M:%S')}] {format % args}")

